REPAIRROOM_MODE=demo
# Later live adapter; not used by the demo. Never add real credentials here.
# DATABASE_URL=postgresql://...

# Optional transactional local demo (npm run db:prepare first):
REPAIRROOM_DEMO_STORAGE=file
# Local-only overrides; normally generated ignored .postgres/local.json is used.
# REPAIRROOM_DEMO_DATABASE_URL=postgresql://.../repairroom_demo
# REPAIRROOM_TEST_DATABASE_URL=postgresql://.../repairroom_test
# DATABASE_URL is deliberately not consumed by this demo or its test runner.
